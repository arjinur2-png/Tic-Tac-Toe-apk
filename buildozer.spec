[app]
title = Tic Tac Toe
package.name = tictactoe
package.domain = org.test
source.dir = .
source.include_exts = py,png,jpg,kv,atlas
version = 0.1
requirements = python3,pygame
orientation = portrait
osx.kivy_version = 2.0.0
